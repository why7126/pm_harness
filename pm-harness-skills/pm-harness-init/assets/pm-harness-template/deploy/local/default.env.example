# 本地默认部署 env 示例。复制为 deploy/local/default.env 后按需修改；真实 env 禁止提交。

PM_HARNESS_DEPLOY_ENV_ID=local-default
APP_ENV=development
APP_DEBUG=true

HOST_PORT_WEB=3000
HOST_PORT_BACKEND=8000
HOST_PORT_MINTLIFY_DOCS=3001

# 本地可使用 SQLite、容器内数据库或外部开发库；真实项目按技术栈调整。
DATABASE_URL=sqlite:///./data/sqlite/app.db

# 对象存储 provider 示例：minio | self-hosted-minio | s3-compatible | oss | cos | obs | local-filesystem
OBJECT_STORAGE_PROVIDER=local-filesystem
OBJECT_STORAGE_BUCKET=local-dev
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_AUTO_CREATE_BUCKET=true
