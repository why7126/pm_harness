# 生产外部依赖部署 env 示例。复制为 deploy/prod/external.env 后替换占位值；真实 env 禁止提交。

PM_HARNESS_DEPLOY_ENV_ID=prod-external
APP_ENV=production
APP_DEBUG=false

HOST_PORT_WEB=3000
HOST_PORT_BACKEND=8000
HOST_PORT_MINTLIFY_DOCS=3001

APP_SECRET_KEY=replace-with-production-secret
ADMIN_INITIAL_PASSWORD=replace-with-production-password
DATABASE_URL=mysql+pymysql://replace-with-user:replace-with-password@replace-with-host:3306/replace-with-db

OBJECT_STORAGE_PROVIDER=s3-compatible
OBJECT_STORAGE_ENDPOINT=https://replace-with-object-storage-endpoint
OBJECT_STORAGE_REGION=replace-with-region
OBJECT_STORAGE_BUCKET=replace-with-bucket
OBJECT_STORAGE_ACCESS_KEY=replace-with-access-key
OBJECT_STORAGE_SECRET_KEY=replace-with-secret-key
OBJECT_STORAGE_AUTO_CREATE_BUCKET=false
