# ==============================================================================
# {PRODUCT_NAME} - Environment Variables Example
# ==============================================================================
# Copy this file to .env for local development.
# Do not commit real secrets, production credentials, access keys, or tokens.

APP_NAME={PRODUCT_CODE}
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-local-env

# Host ports are configurable to avoid conflicts between local projects.
HOST_PORT_BACKEND=8000
HOST_PORT_WEB=3000

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CONTAINER_PORT=8000
BACKEND_BUILD_CONTEXT=./src/backend
BACKEND_DOCKERFILE=Dockerfile
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_BASE_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000

WEB_BUILD_CONTEXT=./src/web
WEB_DOCKERFILE=Dockerfile
WEB_CONTAINER_PORT=3000

WORKER_BUILD_CONTEXT=./src/backend
WORKER_DOCKERFILE=Dockerfile
WORKER_COMMAND=python -m app.worker

ALGORITHM_BUILD_CONTEXT=./src/algorithm
ALGORITHM_DOCKERFILE=Dockerfile
ALGORITHM_CONTAINER_PORT=8100
HOST_PORT_ALGORITHM=8100

# Deployment modes are selected by docker compose profiles:
# 1) self_hosted_object_storage + sqlite: COMPOSE_PROFILES=object-storage
# 2) external_object_storage + sqlite: COMPOSE_PROFILES=
# 3) self_hosted_object_storage + self_hosted_mysql: COMPOSE_PROFILES=object-storage,database
# 4) self_hosted_object_storage + external_mysql: COMPOSE_PROFILES=object-storage
# 5) external_object_storage + self_hosted_mysql: COMPOSE_PROFILES=database
# 6) external_object_storage + external_mysql: COMPOSE_PROFILES=
DEPLOYMENT_STACK=docker-compose
DEPLOYMENT_MODE=self_hosted_object_storage_sqlite
COMPOSE_PROFILES=object-storage
DATABASE_MODE=sqlite
OBJECT_STORAGE_DEPLOYMENT_MODE=self_hosted

# Local development defaults to SQLite. Production defaults to MySQL unless explicitly overridden.
DATABASE_URL=sqlite:////app/data/sqlite/{PRODUCT_CODE}.db
DATABASE_URL_PRODUCTION=mysql+pymysql://{DATABASE_USER}:{DATABASE_PASSWORD}@{DATABASE_HOST}:{DATABASE_PORT}/{DATABASE_NAME}
DATABASE_DEFAULT_POLICY=development_sqlite_production_mysql
DATABASE_NAME={PRODUCT_CODE}
DATABASE_USER={PRODUCT_CODE}
DATABASE_PASSWORD=change-me
DATABASE_ROOT_PASSWORD=change-me
DATABASE_HOST=database
DATABASE_PORT=3306
DATABASE_IMAGE=mysql:8
DATABASE_CONTAINER_PORT=3306
DATABASE_DATA_DIR=/var/lib/mysql
HOST_PORT_DATABASE=3306
DATABASE_HEALTHCHECK_CMD=mysqladmin ping -h 127.0.0.1 -u root -p$${MYSQL_ROOT_PASSWORD}

OBJECT_STORAGE_TYPE=minio
OBJECT_STORAGE_PROVIDER=minio
OBJECT_STORAGE_ENDPOINT=http://object-storage:9000
OBJECT_STORAGE_EXTERNAL_ENDPOINT=https://storage.example.com
OBJECT_STORAGE_ACCESS_KEY=change-me
OBJECT_STORAGE_SECRET_KEY=change-me
OBJECT_STORAGE_SECURE=false
OBJECT_STORAGE_BUCKET={PRODUCT_CODE}
OBJECT_STORAGE_BUCKET_POLICY=one_project_one_bucket
OBJECT_STORAGE_PREFIX_STRATEGY=resource_type_prefix
OBJECT_STORAGE_KEY_PREFIXES=images/,videos/,audios/,files/,tmp/
OBJECT_STORAGE_IMAGE=minio/minio:latest
OBJECT_STORAGE_INIT_IMAGE=minio/mc:latest
OBJECT_STORAGE_COMMAND=server /data --console-address ":9001"
OBJECT_STORAGE_INIT_COMMAND=/bin/sh -c "mc alias set local http://object-storage:9000 $${OBJECT_STORAGE_ACCESS_KEY} $${OBJECT_STORAGE_SECRET_KEY} && mc mb --ignore-existing local/$${OBJECT_STORAGE_BUCKET}"
OBJECT_STORAGE_API_PORT=9000
OBJECT_STORAGE_CONSOLE_PORT=9001
HOST_PORT_OBJECT_STORAGE_API=9000
HOST_PORT_OBJECT_STORAGE_CONSOLE=9001

# MinIO aliases are kept for SDKs that use MinIO-specific names; keep values in sync manually.
MINIO_ENDPOINT=http://object-storage:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_SECURE=false
MINIO_BUCKET={PRODUCT_CODE}

DATA_ROOT=./data
UPLOAD_DIR=/app/data/uploads
PROCESSED_DIR=/app/data/processed
TMP_DIR=/app/data/tmp

MEDIA_ENABLED={MEDIA_ENABLED}
MAX_UPLOAD_SIZE_MB=100
