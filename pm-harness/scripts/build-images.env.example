# ==============================================================================
# PM Harness - Image Build Environment Example
# ==============================================================================
# 复制为 scripts/build-images.env 后按需修改；真实构建配置不要提交。
# 维护要求：新增或修改变量时，必须在变量上一行同步补充用途、取值范围或安全边界注释。

# 镜像版本 tag；建议与产品版本或交付版本一致，例如 v0.0.1。
IMAGE_BUILD_TAG=v0.0.1
# 构建目标平台；离线交付给 x86_64 Linux 服务器时使用 linux/amd64。
IMAGE_BUILD_PLATFORM=linux/amd64

# 后端 Docker 构建基础镜像；默认官方镜像，网络受限时可改为镜像源地址。
BACKEND_PYTHON_BASE_IMAGE=python:3.12-slim
# Web Docker 构建 Node 基础镜像；网络受限时可改为 m.daocloud.io/docker.io/node:22-alpine 等镜像源。
WEB_NODE_BASE_IMAGE=node:22-alpine
# Web Docker 运行 Nginx 基础镜像；网络受限时可改为 m.daocloud.io/docker.io/nginx:1.27-alpine 等镜像源。
WEB_NGINX_BASE_IMAGE=nginx:1.27-alpine

# 后端镜像仓库名；脚本会拼接为 ${IMAGE_BUILD_BACKEND_IMAGE}:${IMAGE_BUILD_TAG}。
IMAGE_BUILD_BACKEND_IMAGE=pm-harness-backend
# Web 镜像仓库名；脚本会拼接为 ${IMAGE_BUILD_WEB_IMAGE}:${IMAGE_BUILD_TAG}。
IMAGE_BUILD_WEB_IMAGE=pm-harness-web

# buildx builder 名称；脚本可自动创建或复用该 builder。
IMAGE_BUILD_BUILDER=pm-harness-builder
# 是否在缺少 builder 时自动创建；本地构建通常为 true。
IMAGE_BUILD_CREATE_BUILDER=true
# 是否将构建结果加载到本地 Docker image store；离线导出和本地验证必须为 true。
IMAGE_BUILD_LOAD=true

# 是否导出包含 backend/web 的 gzip 离线镜像包。
IMAGE_BUILD_EXPORT_TAR=true
# 离线交付输出目录默认由 IMAGE_BUILD_TAG 推导为 releases/${IMAGE_BUILD_TAG}；仅特殊路径时取消注释覆盖。
# IMAGE_BUILD_RELEASE_DIR=releases/v0.0.1
# 离线镜像包文件名默认由 IMAGE_BUILD_TAG 与 IMAGE_BUILD_PLATFORM 推导；仅特殊命名时取消注释覆盖。
# IMAGE_BUILD_TAR_NAME=pm-harness-v0.0.1-linux-amd64.tar.gz
